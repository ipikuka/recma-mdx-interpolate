{
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true, // wait for fix about "mdx/types" in next-mdx-remote-client/rsc
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "noEmit": true,
    "noImplicitReturns": true
  },
  "include": ["src", "tests"]
}
